DEMO_NAME=SpeechShift
DEMO_MODE=development

APP_HOST=127.0.0.1
# 3800 is a development proposal inside the reserved speech UI range. It is not yet an OpenDayOps allocation.
APP_PORT=3800
PORT_ALLOCATION_CONFIRMED=false

# replay is the public-safe default. live and mock ModelDeck are development-only.
SPEECH_PROVIDER=replay
MODELDECK_URL=http://127.0.0.1:8600
MODELDECK_STT_TIMEOUT_SECONDS=15
MODELDECK_TRANSLATION_TIMEOUT_SECONDS=10
MODELDECK_TTS_TIMEOUT_SECONDS=90
MODELDECK_PIPELINE_TIMEOUT_SECONDS=110

AUDIO_SAMPLE_RATE=16000
AUDIO_CHANNELS=1
MAX_INPUT_SECONDS=8
VISITOR_IDLE_TIMEOUT_SECONDS=120
SAFE_OUTPUT_VOLUME=0.75

REPLAY_ASSET_DIR=assets/replay
STORE_VISITOR_AUDIO=false
LOG_TRANSCRIPTS=false
