DEMO_NAME=SpeechShift
DEMO_MODE=development

APP_HOST=127.0.0.1
# 3800 is a development proposal inside the reserved speech UI range. It is not yet an OpenDayOps allocation.
APP_PORT=3800
PORT_ALLOCATION_CONFIRMED=false

# replay is the public-safe default. mock-modeldeck is available only in development.
SPEECH_PROVIDER=replay
MODELDECK_URL=http://127.0.0.1:8600

AUDIO_SAMPLE_RATE=16000
AUDIO_CHANNELS=1
MAX_INPUT_SECONDS=8
SAFE_OUTPUT_VOLUME=0.75

REPLAY_ASSET_DIR=assets/replay
STORE_VISITOR_AUDIO=false
LOG_TRANSCRIPTS=false
